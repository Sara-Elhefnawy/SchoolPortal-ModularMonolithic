# Copy this file to .env and fill in real values. Never commit .env.
DB_PASSWORD=change-me
SEED_Users_PASSWORD=change-me
App__PublicBaseUrl=http://localhost:5229

# Email (SMTP) settings: use your own provider's values
Email__SmtpUsername=your-smtp-username-here
Email__AppPassword=your-smtp-password-here
Email__SenderAddress=your-sender-address-here
Email__SenderDisplayName=SchoolPortal
Email__Host=smtp.example.com
Email__Port=587