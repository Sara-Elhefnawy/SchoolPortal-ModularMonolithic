@using SchoolPortal.SharedKernel.Identity
@{
    ViewData["Title"] ??= "SchoolPortal";

    var isAuthenticated = User.Identity?.IsAuthenticated == true;

    var isAdmin = User.IsInRole(Roles.Admin);
    var isTeacher = User.IsInRole(Roles.Teacher);
    var isStudent = User.IsInRole(Roles.Student);

    var displayName = User.Identity?.Name ?? "User";

    var userRole =
        isAdmin ? "Administrator" :
        isTeacher ? "Teacher" :
        isStudent ? "Student" :
        "User";

    var avatarLetter = string.IsNullOrWhiteSpace(displayName)
        ? "U"
        : displayName.Substring(0, 1).ToUpperInvariant();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - SchoolPortal</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

@if (isAuthenticated)
{
    <div class="app-shell">

        <aside class="sidebar">

            <a class="brand"
               asp-controller="Dashboard"
               asp-action="Index">

                <span class="brand-mark">SP</span>
                <span>SchoolPortal</span>

            </a>

            <nav class="sidebar-nav">

                <a asp-controller="Dashboard"
                   asp-action="Index">
                    Dashboard
                </a>

                @* Students can see student-related pages only.
                   Teachers and Admins can manage students. *@
                <a asp-controller="Students"
                   asp-action="Index">
                    Students
                </a>

                @* Students must NOT see the attendance management page.
                   They access only their own attendance history. *@
                @if (isAdmin || isTeacher)
                {
                    <a asp-controller="Attendances"
                       asp-action="Index">
                        Attendance
                    </a>
                }
                else
                {
                    <a asp-controller="Attendances"
                       asp-action="MyHistory">
                        My Attendance
                    </a>
                }

                <a asp-controller="Grades"
                   asp-action="Index">
                    Grades
                </a>

                @if (isAdmin)
                {
                    <div class="nav-section">
                        Administration
                    </div>

                    <a asp-controller="Admin"
                       asp-action="Users">
                        Users
                    </a>

                    <a asp-controller="Admin"
                       asp-action="Roles">
                        Roles
                    </a>

                    <a asp-controller="Admin"
                       asp-action="Permissions">
                        Permissions
                    </a>
                }

            </nav>

            <div class="sidebar-user">

                <div class="avatar">
                    @avatarLetter
                </div>

                <div class="user-copy">

                    <strong>@displayName</strong>

                    <small>@userRole</small>

                </div>

                <button id="logoutButton"
                        class="btn btn-sm btn-outline-light ms-auto"
                        type="button">
                    Sign out
                </button>

            </div>

        </aside>

        <main class="main-content">

            <header class="topbar">

                <div>

                    <div class="eyebrow">
                        School management
                    </div>

                    <h1>
                        @ViewData["Title"]
                    </h1>

                </div>

                <div class="topbar-user">

                    <span class="status-dot"></span>

                    <span>
                        @displayName
                    </span>

                    <span class="role-badge">
                        @userRole
                    </span>

                </div>

            </header>

            <section class="page-content">

                @RenderBody()

            </section>

        </main>

    </div>
}
else
{
    <main class="auth-shell">

        @RenderBody()

    </main>
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

<!-- Global JavaScript -->
<script src="~/js/site.js" asp-append-version="true"></script>

@if (isAuthenticated)
{
    <script>
        document.getElementById("logoutButton")?.addEventListener("click", async () => {

            const button = document.getElementById("logoutButton");

            // Prevent multiple clicks while logout is being processed.
            button.disabled = true;
            button.textContent = "Signing out...";

            try {
                const response = await apiFetch("/api/account/logout", {
                    method: "POST"
                });

                if (response.ok) {
                    window.location.href = "/Account/Login";
                    return;
                }

                console.error(
                    "Logout failed:",
                    response.status,
                    await response.text()
                );

                button.disabled = false;
                button.textContent = "Sign out";

                if (typeof showToast === "function") {
                    showToast("Could not sign out.", "danger");
                } else {
                    alert("Could not sign out.");
                }
            }
            catch (error) {
                console.error("Logout request failed:", error);

                button.disabled = false;
                button.textContent = "Sign out";

                if (typeof showToast === "function") {
                    showToast("Could not sign out.", "danger");
                } else {
                    alert("Could not sign out.");
                }
            }
        });
    </script>
}

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>