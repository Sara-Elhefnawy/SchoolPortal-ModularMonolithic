@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole("Admin");
    var displayName = User.Identity?.Name ?? "User";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SchoolPortal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (isAuthenticated)
{
    <div class="app-shell">
        <aside class="sidebar">
            <a class="brand" asp-controller="Dashboard" asp-action="Index">
                <span class="brand-mark">SP</span>
                <span>SchoolPortal</span>
            </a>

            <nav class="sidebar-nav">
                <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                <a asp-controller="Students" asp-action="Index">Students</a>
                <a asp-controller="Attendance" asp-action="Index">Attendance</a>
                <a asp-controller="Grades" asp-action="Index">Grades</a>

                @if (isAdmin)
                {
                    <div class="nav-section">Administration</div>
                    <a asp-controller="Admin" asp-action="Users">Users</a>
                    <a asp-controller="Admin" asp-action="Roles">Roles</a>
                    <a asp-controller="Admin" asp-action="Permissions">Permissions</a>
                }
            </nav>

            <div class="sidebar-user">
                <div class="avatar">@displayName.Substring(0, 1).ToUpperInvariant()</div>
                <div class="user-copy">
                    <strong>@displayName</strong>
                    <small>@(isAdmin ? "Administrator" : "Staff")</small>
                </div>
                <button id="logoutButton" class="btn btn-sm btn-outline-light ms-auto" type="button">Sign out</button>
            </div>
        </aside>

        <main class="main-content">
            <header class="topbar">
                <div>
                    <div class="eyebrow">School management</div>
                    <h1>@ViewData["Title"]</h1>
                </div>
                <div class="topbar-user">
                    <span class="status-dot"></span>
                    <span>@displayName</span>
                    <span class="role-badge">@(isAdmin ? "Admin" : "Staff")</span>
                </div>
            </header>

            <section class="page-content">
                @RenderBody()
            </section>
        </main>
    </div>
}
else
{
    <main class="auth-shell">
        @RenderBody()
    </main>
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@if (isAuthenticated)
{
    <script>
        document.getElementById("logoutButton")?.addEventListener("click", async () => {
            const response = await fetch("/api/account/logout", {
                method: "POST",
                credentials: "same-origin"
            });

            if (response.ok) {
                window.location.href = "/Account/Login";
            } else {
                showToast("Could not sign out.", "danger");
            }
        });
    </script>
}
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
