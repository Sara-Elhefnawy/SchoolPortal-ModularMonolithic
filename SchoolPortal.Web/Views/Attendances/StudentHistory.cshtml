@{
    ViewData["Title"] = "Attendance history";
    var studentId = ViewContext.RouteData.Values["id"];
}
<div class="page-toolbar">
    <div><a href="/Students/Details/@studentId" class="back-link">← Student</a><h2>Attendance history</h2></div>
</div>
<div class="panel">
    <div class="table-responsive">
        <table class="table">
            <thead><tr><th>Date</th><th>Status</th><th>Note</th></tr></thead>
            <tbody id="historyBody"><tr><td colspan="3">Loading...</td></tr></tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
const studentId = "@studentId";
async function loadHistory() {
    const result = await callApi(`/api/attendances/by-student/${studentId}`, "GET");
    const body = document.getElementById("historyBody");
    if (!result.ok) {
        body.innerHTML = `<tr><td colspan="3">${escapeHtml(result.message)}</td></tr>`;
        return;
    }
    body.innerHTML = (result.data || []).map(x => `
        <tr><td>${escapeHtml(x.date)}</td><td><span class="status-badge">${escapeHtml(x.status)}</span></td><td>${escapeHtml(x.note || "")}</td></tr>
    `).join("");
}
loadHistory();
</script>
}