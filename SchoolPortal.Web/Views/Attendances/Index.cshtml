@{
    ViewData["Title"] = "Attendance";
}
<div class="page-toolbar">
    <div>
        <h2>Today's classes</h2>
        <p class="text-muted">Choose a class to record attendance.</p>
    </div>
</div>

<div id="sessions" class="cards-grid">
    <div class="panel">Loading today's classes...</div>
</div>

@section Scripts {
    <script>
async function loadSessions() {
    const result = await callApi("/api/sessions/today", "GET");
    const container = document.getElementById("sessions");

    if (!result.ok) {
        container.innerHTML = `<div class="alert alert-danger">${escapeHtml(result.message)}</div>`;
        return;
    }

    const items = result.data || [];
    container.innerHTML = items.length ? items.map(s => `
        <div class="class-card">
            <!-- slice(0,5): the API sends "09:00:00", the UI only needs "09:00" -->
            <div class="class-time">${escapeHtml(s.startTime.slice(0, 5))} – ${escapeHtml(s.endTime.slice(0, 5))}</div>
            <!-- Course names live in the Grades module; Attendances only knows the ID -->
            <h3>Course section #${s.courseSectionId}</h3>
            ${s.occurrenceId
                ? `<a class="btn btn-primary mt-3" href="/Attendances/Mark/${s.occurrenceId}">Mark attendance</a>`
                : `<div class="text-muted mt-3">Not started yet</div>`}
        </div>`).join("") : `<div class="empty-state">No classes scheduled today.</div>`;
}
loadSessions();
    </script>
}