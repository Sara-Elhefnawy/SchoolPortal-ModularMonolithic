@{
ViewData["Title"] = "User Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>User Details</h1>
        <p class="text-muted mb-0">
            View and manage this user's account.
        </p>
    </div>

  
<a asp-controller="Identity"
   asp-action="Users"
   class="btn btn-outline-secondary">
    Back to Users
</a>
  

</div>

<div id="message" class="alert d-none"></div>

<div id="loading" class="text-center py-5">
    <div class="spinner-border" role="status"></div>
    <div class="mt-2">Loading user...</div>
</div>

<div id="userContent" class="d-none">

  
<!-- User Information -->
<div class="card shadow-sm mb-4">

    <div class="card-header">
        <strong>User Information</strong>
    </div>

    <div class="card-body">

        <div class="row">

            <div class="col-md-6 mb-3">
                <label class="form-label">User ID</label>

                <input id="userId"
                       class="form-control"
                       readonly />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Email</label>

                <input id="email"
                       type="email"
                       class="form-control" />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Name</label>

                <input id="name"
                       type="text"
                       class="form-control" />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Phone Number</label>

                <input id="phoneNumber"
                       type="text"
                       class="form-control" />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Username</label>

                <input id="userName"
                       class="form-control"
                       readonly />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Status</label>

                <input id="status"
                       class="form-control"
                       readonly />
            </div>

        </div>

        <button id="saveButton"
                class="btn btn-primary">
            Save Changes
        </button>

    </div>
</div>

<!-- Role -->
<div class="card shadow-sm mb-4">

    <div class="card-header">
        <strong>Role</strong>
    </div>

    <div class="card-body">

        <div class="row align-items-end">

            <div class="col-md-8">

                <label class="form-label">
                    Current / New Role
                </label>

                <select id="roleSelect"
                        class="form-select">
                    <option value="">
                        Select role
                    </option>
                </select>

            </div>

            <div class="col-md-4">

                <button id="assignRoleButton"
                        class="btn btn-primary">
                    Assign Role
                </button>

            </div>

        </div>

    </div>
</div>

<!-- Account Actions -->
<div class="card shadow-sm mb-4">

    <div class="card-header">
        <strong>Account Actions</strong>
    </div>

    <div class="card-body">

        <div class="d-flex gap-2 flex-wrap">

            <button id="activateButton"
                    class="btn btn-success">
                Activate
            </button>

            <button id="deactivateButton"
                    class="btn btn-warning">
                Deactivate
            </button>

            <button id="restoreButton"
                    class="btn btn-info">
                Restore
            </button>

            <button id="deleteButton"
                    class="btn btn-danger">
                Delete
            </button>

        </div>

    </div>
</div>
  

</div>

@section Scripts {

<script>

    const userId = @ViewContext.RouteData.Values["id"];

    const usersUrl = `/api/admin/users/${userId}`;
    const rolesUrl = "/api/admin/roles";

    const messageElement =
        document.getElementById("message");

    function showMessage(message, success = true) {

        messageElement.textContent = message;

        messageElement.className =
            success
                ? "alert alert-success"
                : "alert alert-danger";
    }

    async function loadUser() {

        const response =
            await fetch(usersUrl);

        if (!response.ok) {

            document.getElementById("loading")
                .innerHTML = `
                    <div class="alert alert-danger">
                        Failed to load user.
                    </div>
                `;

            return;
        }

        const result =
            await response.json();

        const user =
            result.value ?? result;

        document.getElementById("userId").value =
            user.id ?? "";

        document.getElementById("email").value =
            user.email ?? "";

        document.getElementById("name").value =
            user.name ?? "";

        document.getElementById("phoneNumber").value =
            user.phoneNumber ?? "";

        document.getElementById("userName").value =
            user.userName ?? "";

        const isDeleted =
            user.isDeleted === true;

        const isActive =
            user.isActive !== false;

        document.getElementById("status").value =
            isDeleted
                ? "Deleted"
                : isActive
                    ? "Active"
                    : "Inactive";

        document.getElementById("loading")
            .classList.add("d-none");

        document.getElementById("userContent")
            .classList.remove("d-none");
    }

    async function loadRoles() {

        const response =
            await fetch(rolesUrl);

        if (!response.ok) {
            return;
        }

        const result =
            await response.json();

        const roles =
            result.value ?? result;

        const select =
            document.getElementById("roleSelect");

        select.innerHTML =
            '<option value="">Select role</option>';

        roles.forEach(role => {

            const option =
                document.createElement("option");

            option.value = role.name;
            option.textContent = role.name;

            select.appendChild(option);
        });
    }

    document
        .getElementById("saveButton")
        .addEventListener("click", async function () {

            const response =
                await fetch(usersUrl, {
                    method: "PUT",

                    headers: {
                        "Content-Type":
                            "application/json"
                    },

                    body: JSON.stringify({
                        email:
                            document.getElementById(
                                "email").value,

                        name:
                            document.getElementById(
                                "name").value,

                        phoneNumber:
                            document.getElementById(
                                "phoneNumber").value
                    })
                });

            if (!response.ok) {

                showMessage(
                    "Failed to update user.",
                    false);

                return;
            }

            showMessage(
                "User updated successfully.");

            await loadUser();
        });

    document
        .getElementById("assignRoleButton")
        .addEventListener("click", async function () {

            const roleName =
                document.getElementById(
                    "roleSelect").value;

            if (!roleName) {

                showMessage(
                    "Please select a role.",
                    false);

                return;
            }

            const response =
                await fetch(
                    `${usersUrl}/roles`,
                    {
                        method: "POST",

                        headers: {
                            "Content-Type":
                                "application/json"
                        },

                        body: JSON.stringify({
                            roleName: roleName
                        })
                    });

            if (!response.ok) {

                showMessage(
                    "Failed to assign role.",
                    false);

                return;
            }

            showMessage(
                "Role assigned successfully.");
        });

    document
        .getElementById("activateButton")
        .addEventListener("click", async function () {

            const response =
                await fetch(
                    `${usersUrl}/activate`,
                    {
                        method: "POST"
                    });

            if (!response.ok) {

                showMessage(
                    "Failed to activate user.",
                    false);

                return;
            }

            showMessage(
                "User activated successfully.");

            await loadUser();
        });

    document
        .getElementById("deactivateButton")
        .addEventListener("click", async function () {

            const response =
                await fetch(
                    `${usersUrl}/deactivate`,
                    {
                        method: "POST"
                    });

            if (!response.ok) {

                showMessage(
                    "Failed to deactivate user.",
                    false);

                return;
            }

            showMessage(
                "User deactivated successfully.");

            await loadUser();
        });

    document
        .getElementById("restoreButton")
        .addEventListener("click", async function () {

            const response =
                await fetch(
                    `${usersUrl}/restore`,
                    {
                        method: "POST"
                    });

            if (!response.ok) {

                showMessage(
                    "Failed to restore user.",
                    false);

                return;
            }

            showMessage(
                "User restored successfully.");

            await loadUser();
        });

    document
        .getElementById("deleteButton")
        .addEventListener("click", async function () {

            if (!confirm(
                "Are you sure you want to delete this user?")) {
                return;
            }

            const response =
                await fetch(usersUrl, {
                    method: "DELETE"
                });

            if (!response.ok) {

                showMessage(
                    "Failed to delete user.",
                    false);

                return;
            }

            showMessage(
                "User deleted successfully.");

            await loadUser();
        });

    loadUser();
    loadRoles();

</script>

}
