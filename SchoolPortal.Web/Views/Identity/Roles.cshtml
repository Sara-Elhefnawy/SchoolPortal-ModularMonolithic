@{
ViewData["Title"] = "Roles";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Roles</h1>
        <p class="text-muted mb-0">
            Manage application roles and their permissions.
        </p>
    </div>

  
<a asp-controller="Identity"
   asp-action="Index"
   class="btn btn-outline-secondary">
    Back
</a>
  

</div>

<div id="message" class="alert d-none"></div>

<!-- Create Role -->

<div class="card shadow-sm mb-4">
    <div class="card-header">
        <strong>Create Role</strong>
    </div>

  
<div class="card-body">

    <form id="createRoleForm">

        <div class="row align-items-end">

            <div class="col-md-8">
                <label for="roleName" class="form-label">
                    Role Name
                </label>

                <input id="roleName"
                       type="text"
                       class="form-control"
                       placeholder="Teacher"
                       required />
            </div>

            <div class="col-md-4">
                <button type="submit"
                        class="btn btn-primary">
                    Create Role
                </button>
            </div>

        </div>

    </form>

</div>
  

</div>

<!-- Roles -->

<div class="card shadow-sm">

  
<div class="card-header d-flex justify-content-between align-items-center">

    <strong>Roles</strong>

    <button id="refreshRoles"
            type="button"
            class="btn btn-sm btn-outline-primary">
        Refresh
    </button>

</div>

<div class="card-body">

    <div class="table-responsive">

        <table class="table table-hover align-middle">

            <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Actions</th>
            </tr>
            </thead>

            <tbody id="rolesTableBody">
            </tbody>

        </table>

    </div>

</div>
  

</div>

<!-- Permissions Modal -->

<div class="modal fade"
     id="permissionsModal"
     tabindex="-1"
     aria-hidden="true">

  
<div class="modal-dialog modal-lg">

    <div class="modal-content">

        <div class="modal-header">

            <h5 class="modal-title">
                Role Permissions
            </h5>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                    aria-label="Close">
            </button>

        </div>

        <div class="modal-body">

            <input id="permissionRoleId"
                   type="hidden" />

            <div id="permissionsContainer">
            </div>

        </div>

        <div class="modal-footer">

            <button type="button"
                    class="btn btn-secondary"
                    data-bs-dismiss="modal">
                Cancel
            </button>

            <button id="savePermissions"
                    type="button"
                    class="btn btn-primary">
                Save Permissions
            </button>

        </div>

    </div>

</div>
  

</div>

@section Scripts {

  
<script>

    const rolesUrl = "/api/admin/roles";
    const permissionsUrl = "/api/admin/permissions";

    const messageElement =
        document.getElementById("message");

    function showMessage(message, success = true) {

        messageElement.textContent = message;

        messageElement.className =
            success
                ? "alert alert-success"
                : "alert alert-danger";
    }

    function hideMessage() {
        messageElement.classList.add("d-none");
    }

    async function loadRoles() {

        const response =
            await fetch(rolesUrl);

        if (!response.ok) {

            showMessage(
                "Failed to load roles.",
                false);

            return;
        }

        const result =
            await response.json();

        const roles =
            result.value ?? result;

        const tbody =
            document.getElementById("rolesTableBody");

        tbody.innerHTML = "";

        roles.forEach(role => {

            const row =
                document.createElement("tr");

            row.innerHTML = `
                <td>
                    ${role.id}
                </td>

                <td>
                    ${role.name ?? ""}
                </td>

                <td>

                    <a
                        href="/Identity/RoleDetails/${role.id}"
                        class="btn btn-sm btn-outline-primary me-1">
                        Details
                    </a>

                    <button
                        type="button"
                        class="btn btn-sm btn-outline-secondary me-1"
                        onclick="editRole(${role.id}, '${escapeJavaScript(role.name)}')">
                        Edit
                    </button>

                    <button
                        type="button"
                        class="btn btn-sm btn-outline-secondary me-1"
                        onclick="managePermissions(${role.id})">
                        Permissions
                    </button>

                    <button
                        type="button"
                        class="btn btn-sm btn-outline-danger"
                        onclick="deleteRole(${role.id})">
                        Delete
                    </button>

                </td>
            `;

            tbody.appendChild(row);
        });
    }

    function escapeJavaScript(value) {

        return String(value ?? "")
            .replaceAll("\\", "\\\\")
            .replaceAll("'", "\\'")
            .replaceAll("\r", "\\r")
            .replaceAll("\n", "\\n");
    }

    document
        .getElementById("createRoleForm")
        .addEventListener(
            "submit",
            async function (event) {

                event.preventDefault();

                hideMessage();

                const name =
                    document
                        .getElementById("roleName")
                        .value
                        .trim();

                if (!name) {

                    showMessage(
                        "Role name is required.",
                        false);

                    return;
                }

                const response =
                    await fetch(rolesUrl, {

                        method: "POST",

                        headers: {
                            "Content-Type":
                                "application/json"
                        },

                        body: JSON.stringify({
                            name: name
                        })
                    });

                if (!response.ok) {

                    showMessage(
                        "Failed to create role.",
                        false);

                    return;
                }

                this.reset();

                showMessage(
                    "Role created successfully.");

                await loadRoles();
            });

    async function editRole(id, oldName) {

        const name =
            prompt(
                "Enter the new role name:",
                oldName);

        if (!name || name.trim() === oldName) {
            return;
        }

        const response =
            await fetch(
                `${rolesUrl}/${id}`,
                {
                    method: "PUT",

                    headers: {
                        "Content-Type":
                            "application/json"
                    },

                    body: JSON.stringify({
                        name: name.trim()
                    })
                });

        if (!response.ok) {

            showMessage(
                "Failed to update role.",
                false);

            return;
        }

        showMessage(
            "Role updated successfully.");

        await loadRoles();
    }

    async function deleteRole(id) {

        if (!confirm(
            "Are you sure you want to delete this role?")) {

            return;
        }

        const response =
            await fetch(
                `${rolesUrl}/${id}`,
                {
                    method: "DELETE"
                });

        if (!response.ok) {

            showMessage(
                "Failed to delete role.",
                false);

            return;
        }

        showMessage(
            "Role deleted successfully.");

        await loadRoles();
    }

    async function managePermissions(roleId) {

        document
            .getElementById("permissionRoleId")
            .value = roleId;

        const permissionsResponse =
            await fetch(permissionsUrl);

        if (!permissionsResponse.ok) {

            showMessage(
                "Failed to load permissions.",
                false);

            return;
        }

        const allResult =
            await permissionsResponse.json();

        const allPermissions =
            allResult.value ?? allResult;

        const roleResponse =
            await fetch(
                `${rolesUrl}/${roleId}/permissions`);

        if (!roleResponse.ok) {

            showMessage(
                "Failed to load role permissions.",
                false);

            return;
        }

        const roleResult =
            await roleResponse.json();

        const rolePermissions =
            roleResult.value ?? roleResult;

        const selectedIds =
            rolePermissions.map(permission =>
                permission.permissionId ??
                permission.permission?.id);

        const container =
            document.getElementById(
                "permissionsContainer");

        container.innerHTML = "";

        allPermissions.forEach(permission => {

            const checked =
                selectedIds.includes(permission.id)
                    ? "checked"
                    : "";

            container.innerHTML += `
                <div class="form-check mb-3">

                    <input
                        class="form-check-input permission-checkbox"
                        type="checkbox"
                        value="${permission.id}"
                        id="permission-${permission.id}"
                        ${checked} />

                    <label
                        class="form-check-label"
                        for="permission-${permission.id}">

                        <strong>
                            ${permission.name}
                        </strong>

                        <small class="text-muted d-block">
                            ${permission.description ?? ""}
                        </small>

                    </label>

                </div>
            `;
        });

        const modalElement =
            document.getElementById(
                "permissionsModal");

        const modal =
            bootstrap.Modal.getOrCreateInstance(
                modalElement);

        modal.show();
    }

    document
        .getElementById("savePermissions")
        .addEventListener(
            "click",
            async function () {

                const roleId =
                    document.getElementById(
                        "permissionRoleId")
                        .value;

                const permissionIds =
                    Array.from(
                        document.querySelectorAll(
                            ".permission-checkbox:checked"))
                        .map(
                            checkbox =>
                                Number(checkbox.value));

                const response =
                    await fetch(
                        `${rolesUrl}/${roleId}/permissions`,
                        {
                            method: "PUT",

                            headers: {
                                "Content-Type":
                                    "application/json"
                            },

                            body: JSON.stringify({
                                permissionIds:
                                    permissionIds
                            })
                        });

                if (!response.ok) {

                    showMessage(
                        "Failed to update permissions.",
                        false);

                    return;
                }

                const modalElement =
                    document.getElementById(
                        "permissionsModal");

                const modal =
                    bootstrap.Modal.getInstance(
                        modalElement);

                modal?.hide();

                showMessage(
                    "Role permissions updated successfully.");
            });

    document
        .getElementById("refreshRoles")
        .addEventListener(
            "click",
            loadRoles);

    loadRoles();

</script>
  

}
