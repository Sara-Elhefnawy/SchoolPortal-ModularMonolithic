@{
ViewData["Title"] = "Identity Administration";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Identity Administration</h1>
        <p class="text-muted mb-0">
            Manage users, roles, and permissions.
        </p>
    </div>
</div>

<div class="row g-4">

    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h4 class="card-title">Users</h4>
                <p class="card-text text-muted">
                    Create, update, activate, deactivate, delete,
                    restore, and assign roles to users.
                </p>

                <a asp-controller="Identity"
                   asp-action="Users"
                   class="btn btn-primary">
                    Manage Users
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h4 class="card-title">Roles</h4>
                <p class="card-text text-muted">
                    Create and manage application roles and their
                    permissions.
                </p>

                <a asp-controller="Identity"
                   asp-action="Roles"
                   class="btn btn-primary">
                    Manage Roles
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h4 class="card-title">Permissions</h4>
                <p class="card-text text-muted">
                    View the available permissions in the system.
                </p>

                <a asp-controller="Identity"
                   asp-action="Permissions"
                   class="btn btn-primary">
                    View Permissions
                </a>
            </div>
        </div>
    </div>

</div>
