@{
ViewData["Title"] = "Role Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">

  
<div>
    <h1>Role Details</h1>

    <p class="text-muted mb-0">
        Manage this role and its permissions.
    </p>
</div>

<a asp-controller="Identity"
   asp-action="Roles"
   class="btn btn-outline-secondary">
    Back to Roles
</a>
  

</div>

<div id="message"
     class="alert d-none">
</div>

<div id="loading"
     class="text-center py-5">

  
<div class="spinner-border"
     role="status">
</div>

<div class="mt-2">
    Loading role...
</div>
  

</div>

<div id="roleContent"
     class="d-none">

  
<!-- Role Information -->

<div class="card shadow-sm mb-4">

    <div class="card-header">
        <strong>Role Information</strong>
    </div>

    <div class="card-body">

        <input id="roleId"
               type="hidden" />

        <div class="row">

            <div class="col-md-4 mb-3">

                <label class="form-label">
                    Role ID
                </label>

                <input id="roleIdDisplay"
                       class="form-control"
                       readonly />

            </div>

            <div class="col-md-8 mb-3">

                <label class="form-label">
                    Role Name
                </label>

                <input id="roleName"
                       type="text"
                       class="form-control"
                       required />

            </div>

        </div>

        <button id="saveRole"
                class="btn btn-primary">
            Save Changes
        </button>

    </div>

</div>


<!-- Permissions -->

<div class="card shadow-sm mb-4">

    <div class="card-header d-flex justify-content-between">

        <strong>Permissions</strong>

        <button id="selectAll"
                type="button"
                class="btn btn-sm btn-outline-secondary">
            Select All
        </button>

    </div>

    <div class="card-body">

        <p class="text-muted">
            Select the permissions that this role should have.
        </p>

        <div id="permissionsContainer">
        </div>

        <button id="savePermissions"
                class="btn btn-primary mt-3">
            Save Permissions
        </button>

    </div>

</div>


<!-- Role Actions -->

<div class="card shadow-sm">

    <div class="card-header">
        <strong>Role Actions</strong>
    </div>

    <div class="card-body">

        <div class="d-flex gap-2">

            <button id="restoreRole"
                    class="btn btn-info">
                Restore
            </button>

            <button id="deleteRole"
                    class="btn btn-danger">
                Delete
            </button>

        </div>

    </div>

</div>
  

</div>

@section Scripts {

<script>

    const roleId =
        @ViewContext.RouteData.Values["id"];

    const roleUrl =
        `/api/admin/roles/${roleId}`;

    const permissionsUrl =
        "/api/admin/permissions";

    const rolePermissionsUrl =
        `${roleUrl}/permissions`;

    const messageElement =
        document.getElementById("message");

    function showMessage(message, success = true) {

        messageElement.textContent =
            message;

        messageElement.className =
            success
                ? "alert alert-success"
                : "alert alert-danger";
    }

    async function loadRole() {

        const response =
            await fetch(roleUrl);

        if (!response.ok) {

            document.getElementById("loading")
                .innerHTML = `
                    <div class="alert alert-danger">
                        Failed to load role.
                    </div>
                `;

            return;
        }

        const result =
            await response.json();

        const role =
            result.value ?? result;

        document.getElementById("roleId").value =
            role.id;

        document.getElementById("roleIdDisplay").value =
            role.id;

        document.getElementById("roleName").value =
            role.name ?? "";

        document.getElementById("loading")
            .classList.add("d-none");

        document.getElementById("roleContent")
            .classList.remove("d-none");
    }

    async function loadPermissions() {

        const allResponse =
            await fetch(permissionsUrl);

        if (!allResponse.ok) {

            showMessage(
                "Failed to load permissions.",
                false);

            return;
        }

        const allResult =
            await allResponse.json();

        const allPermissions =
            allResult.value ?? allResult;

        const roleResponse =
            await fetch(rolePermissionsUrl);

        if (!roleResponse.ok) {

            showMessage(
                "Failed to load role permissions.",
                false);

            return;
        }

        const roleResult =
            await roleResponse.json();

        const rolePermissions =
            roleResult.value ?? roleResult;

        const selectedIds =
            rolePermissions.map(permission =>
                permission.permissionId ??
                permission.permission?.id);

        const container =
            document.getElementById(
                "permissionsContainer");

        container.innerHTML = "";

        allPermissions.forEach(permission => {

            const isChecked =
                selectedIds.includes(permission.id);

            const wrapper =
                document.createElement("div");

            wrapper.className =
                "border rounded p-3 mb-2";

            wrapper.innerHTML = `

                <div class="form-check">

                    <input
                        class="form-check-input permission-checkbox"
                        type="checkbox"
                        value="${permission.id}"
                        id="permission-${permission.id}"
                        ${isChecked ? "checked" : ""} />

                    <label
                        class="form-check-label"
                        for="permission-${permission.id}">

                        <strong>
                            ${permission.name}
                        </strong>

                        <span class="text-muted d-block">
                            ${permission.description ?? ""}
                        </span>

                    </label>

                </div>
            `;

            container.appendChild(wrapper);
        });
    }

    document
        .getElementById("saveRole")
        .addEventListener("click", async function () {

            const name =
                document.getElementById(
                    "roleName").value;

            if (!name.trim()) {

                showMessage(
                    "Role name is required.",
                    false);

                return;
            }

            const response =
                await fetch(roleUrl, {
                    method: "PUT",

                    headers: {
                        "Content-Type":
                            "application/json"
                    },

                    body: JSON.stringify({
                        name: name
                    })
                });

            if (!response.ok) {

                showMessage(
                    "Failed to update role.",
                    false);

                return;
            }

            showMessage(
                "Role updated successfully.");

            await loadRole();
        });

    document
        .getElementById("savePermissions")
        .addEventListener("click", async function () {

            const permissionIds =
                Array.from(
                    document.querySelectorAll(
                        ".permission-checkbox:checked"))
                    .map(
                        checkbox =>
                            Number(checkbox.value));

            const response =
                await fetch(
                    rolePermissionsUrl,
                    {
                        method: "PUT",

                        headers: {
                            "Content-Type":
                                "application/json"
                        },

                        body: JSON.stringify({
                            permissionIds:
                                permissionIds
                        })
                    });

            if (!response.ok) {

                showMessage(
                    "Failed to update permissions.",
                    false);

                return;
            }

            showMessage(
                "Permissions updated successfully.");

            await loadPermissions();
        });

    document
        .getElementById("selectAll")
        .addEventListener("click", function () {

            const checkboxes =
                document.querySelectorAll(
                    ".permission-checkbox");

            const shouldSelect =
                Array.from(checkboxes)
                    .some(x => !x.checked);

            checkboxes.forEach(
                checkbox =>
                    checkbox.checked = shouldSelect);
        });

    document
        .getElementById("deleteRole")
        .addEventListener("click", async function () {

            if (!confirm(
                "Are you sure you want to delete this role?")) {
                return;
            }

            const response =
                await fetch(roleUrl, {
                    method: "DELETE"
                });

            if (!response.ok) {

                showMessage(
                    "Failed to delete role.",
                    false);

                return;
            }

            showMessage(
                "Role deleted successfully.");

            await loadRole();
        });

    document
        .getElementById("restoreRole")
        .addEventListener("click", async function () {

            const response =
                await fetch(
                    `${roleUrl}/restore`,
                    {
                        method: "POST"
                    });

            if (!response.ok) {

                showMessage(
                    "Failed to restore role.",
                    false);

                return;
            }

            showMessage(
                "Role restored successfully.");

            await loadRole();
        });

    loadRole();
    loadPermissions();

</script>

}
