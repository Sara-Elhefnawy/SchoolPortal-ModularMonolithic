@{
    ViewData["Title"] = "Rankings";
}
<div class="page-toolbar">
    <div><a href="/Grades/Index" class="back-link">← Grades</a><h2>Course rankings</h2></div>
</div>
<div class="panel">
    <label class="form-label">Course section</label>
    <div class="input-group mb-4">
        <input id="sectionId" class="form-control" type="number" placeholder="Course section ID" />
        <button class="btn btn-primary" id="loadRankings">View rankings</button>
    </div>
    <div class="table-responsive">
        <table class="table"><thead><tr><th>Rank</th><th>Student</th><th>Average</th></tr></thead>
            <tbody id="rankingBody"></tbody></table>
    </div>
</div>
@section Scripts {
    <script>
document.getElementById("loadRankings").addEventListener("click", async () => {
    const id = document.getElementById("sectionId").value;
    if (!id) return;
    const result = await callApi(`/api/course-sections/${id}/rankings`, "GET");
    const body = document.getElementById("rankingBody");
    if (!result.ok) {
        body.innerHTML = `<tr><td colspan="3">${escapeHtml(result.message)}</td></tr>`;
        return;
    }
    body.innerHTML = (result.data || []).map((r, i) =>
        `<tr><td>${r.rank ?? i + 1}</td><td>${escapeHtml(r.studentName)}</td><td>${r.weightedAverage}</td></tr>`
    ).join("");
});
</script>
}