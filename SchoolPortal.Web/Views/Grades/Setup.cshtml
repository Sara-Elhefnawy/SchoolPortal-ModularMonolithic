@{
    ViewData["Title"] = "Academic setup";
}
<div class="page-toolbar"><div><a href="/Grades/Index" class="back-link">← Grades</a><h2>Academic setup</h2></div></div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="panel">
            <h5>Academic years</h5>
            <form id="yearForm" class="mb-3">
                <input class="form-control mb-2" name="name" placeholder="2026/2027" required />
                <input class="form-control mb-2" name="startDate" type="date" required />
                <input class="form-control mb-2" name="endDate" type="date" required />
                <button class="btn btn-primary w-100">Add academic year</button>
            </form>
            <div id="yearsList">Loading...</div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="panel">
            <h5>Courses</h5>
            <form id="courseForm" class="mb-3">
                <input class="form-control mb-2" name="name" placeholder="Course name" required />
                <input class="form-control mb-2" name="code" placeholder="Code, e.g. CS101" required />
                <input class="form-control mb-2" name="creditHours" type="number" step="0.5" placeholder="Credit hours" required />
                <button class="btn btn-primary w-100">Add course</button>
            </form>
            <div id="coursesList">Loading...</div>
        </div>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-md-4">
        <div class="panel">
            <h5>Terms</h5>
            <label class="form-label">Academic year</label>
            <select id="yearSelect" class="form-select mb-3"></select>
            <form id="termForm" class="mb-3">
                <input class="form-control mb-2" name="name" placeholder="Term 1" required />
                <input class="form-control mb-2" name="startDate" type="date" required />
                <input class="form-control mb-2" name="endDate" type="date" required />
                <button class="btn btn-primary w-100">Add term</button>
            </form>
            <div id="termsList"></div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="panel">
            <h5>Course sections</h5>
            <label class="form-label">Term</label>
            <select id="termSelect" class="form-select mb-3"></select>
            <form id="sectionForm" class="mb-3">
                <select class="form-select mb-2" name="courseId" id="courseSelect" required></select>
                <input class="form-control mb-2" name="name" placeholder="Section name, e.g. A" />
                <button class="btn btn-primary w-100">Add section</button>
            </form>
            <div id="sectionsList"></div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="panel">
            <h5>Assessments</h5>
            <label class="form-label">Course section</label>
            <select id="sectionSelect" class="form-select mb-3"></select>
            <form id="assessmentForm" class="mb-3">
                <input class="form-control mb-2" name="name" placeholder="Midterm" required />

                <!-- Why a <select>: the backend enum only accepts its defined names, so free text would just fail validation. -->
                <!-- Add the rest of your AssessmentType members here; names must match the enum exactly. -->
                <select class="form-select mb-2" name="type" required>
                    <option value="Quiz">Quiz</option>
                    <option value="Midterm">Midterm</option>
                    <option value="FinalExam">Final exam</option>
                </select>

                <!-- Why name="maximumScore": the JSON property name must match the command's MaximumScore. -->
                <input class="form-control mb-2" name="maximumScore" type="number" step="0.5" min="0.5" placeholder="Max score" required />

                <!-- Why a fraction: Assessment.Validate requires 0 < weight <= 1, and the handler sums weights against 1. -->
                <input class="form-control mb-2" name="weight" type="number" step="0.01" min="0.01" max="1" placeholder="Weight as a fraction (0.2 = 20%)" required />

                <!-- Why a date input: the command's Date is a DateOnly, and type="date" sends "yyyy-MM-dd", which parses directly. -->
                <input class="form-control mb-2" name="date" type="date" required />

                <button class="btn btn-primary w-100">Add assessment</button>
            </form>
            <div id="assessmentsList"></div>
        </div>
    </div>
</div>

@section Scripts {
<script>
const el = id => document.getElementById(id);

// Why pick(): I don't know every DTO's exact property names. This reads the first
// one that exists, so a slightly different name shows data instead of "undefined".
const pick = (o, ...keys) => {
    for (const k of keys) if (o[k] !== undefined && o[k] !== null) return o[k];
    return "";
};

function fillSelect(select, items, labelOf, emptyText) {
    select.innerHTML = items.length
        ? items.map(i => `<option value="${i.id}">${escapeHtml(labelOf(i))}</option>`).join("")
        : `<option value="">${escapeHtml(emptyText)}</option>`;
}

// Why one helper for all five create forms: they differ only in URL, the parent id
// they add, and which fields are numbers.
async function createFrom(form, url, extra, numericFields, okMessage, reload) {
    const r = await callApi(url, "POST", { ...formToObject(form, numericFields), ...extra });
    showToast(r.ok ? okMessage : (r.message || "Could not save."), r.ok ? "success" : "danger");
    if (r.ok) { form.reset(); reload(); }
}

// ---------- Years ----------
async function loadYears() {
    const r = await callApi("/api/academic-years", "GET");
    const box = el("yearsList");
    if (!r.ok) { box.textContent = r.message; return; }

    const years = r.data || [];
    box.innerHTML = years.map(y => `
        <div class="permission-row">
            <span><strong>${escapeHtml(y.name)}</strong> <small>${y.isCurrent ? "Current" : ""}</small></span>
            ${y.isCurrent ? "" : `<button class="btn btn-sm btn-outline-primary" onclick="markCurrent(${y.id})">Make current</button>`}
        </div>`).join("") || "No academic years yet.";

    // Why preselect the current year: it's almost always the one being worked on.
    fillSelect(el("yearSelect"), years, y => y.name, "No academic years");
    const current = years.find(y => y.isCurrent) || years[0];
    if (current) el("yearSelect").value = current.id;
    loadTerms();
}

async function markCurrent(id) {
    const r = await callApi(`/api/academic-years/${id}/mark-current`, "POST");
    showToast(r.ok ? "Updated." : (r.message || "Failed."), r.ok ? "success" : "danger");
    if (r.ok) loadYears();
}

// ---------- Courses ----------
async function loadCourses() {
    const r = await callApi("/api/courses", "GET");
    const box = el("coursesList");
    if (!r.ok) { box.textContent = r.message; return; }

    const courses = r.data || [];
    box.innerHTML = courses.map(c => `
        <div class="permission-row"><span><strong>${escapeHtml(c.code)}</strong> <small>${escapeHtml(c.name)}</small></span></div>`
    ).join("") || "No courses yet.";

    fillSelect(el("courseSelect"), courses, c => `${c.code} – ${c.name}`, "Add a course first");
}

// ---------- Terms ----------
async function loadTerms() {
    const yearId = el("yearSelect").value;
    const box = el("termsList");

    if (!yearId) {
        box.textContent = "Create an academic year first.";
        fillSelect(el("termSelect"), [], t => "", "No terms");
        loadSections();
        return;
    }

    const r = await callApi(`/api/terms?academicYearId=${yearId}`, "GET");
    if (!r.ok) { box.textContent = r.message; return; }

    const terms = r.data || [];
    box.innerHTML = terms.map(t => `
        <div class="permission-row">
            <span><strong>${escapeHtml(t.name)}</strong>
            <small>${escapeHtml(pick(t, "startDate"))} → ${escapeHtml(pick(t, "endDate"))}</small></span>
            ${t.isEnded === true
                ? "<small>Ended</small>"
                : `<button class="btn btn-sm btn-outline-warning" onclick="endTerm(${t.id})">End term</button>`}
        </div>`).join("") || "No terms for this year yet.";

    fillSelect(el("termSelect"), terms, t => t.name, "No terms");
    loadSections();
}

async function endTerm(id) {
    if (!confirm("End this term?")) return;
    const r = await callApi(`/api/terms/${id}/end`, "POST");
    showToast(r.ok ? "Term ended." : (r.message || "Failed."), r.ok ? "success" : "danger");
    if (r.ok) loadTerms();
}

// ---------- Sections ----------
const sectionLabel = s =>
    [pick(s, "courseCode", "courseName"), pick(s, "name")].filter(Boolean).join(" · ") || `Section #${s.id}`;

async function loadSections() {
    const termId = el("termSelect").value;
    const box = el("sectionsList");

    if (!termId) {
        box.textContent = "Pick a term.";
        fillSelect(el("sectionSelect"), [], sectionLabel, "No sections");
        loadAssessments();
        return;
    }

    const r = await callApi(`/api/course-sections?termId=${termId}`, "GET");
    if (!r.ok) { box.textContent = r.message; return; }

    const sections = r.data || [];
    box.innerHTML = sections.map(s => `
        <div class="permission-row"><span><strong>${escapeHtml(sectionLabel(s))}</strong></span></div>`
    ).join("") || "No sections for this term yet.";

    fillSelect(el("sectionSelect"), sections, sectionLabel, "No sections");
    loadAssessments();
}

// ---------- Assessments ----------
async function loadAssessments() {
    const sectionId = el("sectionSelect").value;
    const box = el("assessmentsList");

    if (!sectionId) {
        box.textContent = "Pick a course section.";
        return;
    }

    const r = await callApi(`/api/assessments?courseSectionId=${sectionId}`, "GET");
    if (!r.ok) {
        box.textContent = r.message;
        return;
    }

    box.innerHTML = (r.data || []).map(a => `
        <div class="permission-row">
            <span><strong>${escapeHtml(a.name)}</strong>
            <small>max ${escapeHtml(pick(a, "maximumScore", "maxScore"))} · weight ${escapeHtml(pick(a, "weight"))}</small></span>
        </div>`).join("") || "No assessments for this section yet.";
}

// ---------- Wiring ----------
el("yearSelect").addEventListener("change", loadTerms);
el("termSelect").addEventListener("change", loadSections);
el("sectionSelect").addEventListener("change", loadAssessments);

el("yearForm").addEventListener("submit", e => {
    e.preventDefault();
    createFrom(e.target, "/api/academic-years", {}, [], "Academic year added.", loadYears);
});
el("courseForm").addEventListener("submit", e => {
    e.preventDefault();
    createFrom(e.target, "/api/courses", {}, ["creditHours"], "Course added.", loadCourses);
});
el("termForm").addEventListener("submit", e => {
    e.preventDefault();
    const academicYearId = Number(el("yearSelect").value);
    if (!academicYearId) { showToast("Pick an academic year first.", "danger"); return; }
    createFrom(e.target, "/api/terms", { academicYearId }, [], "Term added.", loadTerms);
});
el("sectionForm").addEventListener("submit", e => {
    e.preventDefault();
    const termId = Number(el("termSelect").value);
    if (!termId) { showToast("Pick a term first.", "danger"); return; }
    createFrom(e.target, "/api/course-sections", { termId }, ["courseId"], "Section added.", loadSections);
});
el("assessmentForm").addEventListener("submit", e => {
    e.preventDefault();
    const courseSectionId = Number(el("sectionSelect").value);
    if (!courseSectionId) { showToast("Pick a course section first.", "danger"); return; }
    // Why "maximumScore" here: formToObject converts these fields to numbers,
    // and the name must match the form input and the backend property.
    createFrom(e.target, "/api/assessments", { courseSectionId }, ["maximumScore", "weight"], "Assessment added.", loadAssessments);
});

loadCourses();
loadYears();   // loadYears triggers loadTerms, which triggers loadSections, then loadAssessments
</script>
}