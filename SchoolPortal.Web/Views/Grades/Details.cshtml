@{
    ViewData["Title"] = "Grade details";
    var id = ViewContext.RouteData.Values["id"];
    var isAdmin = User.IsInRole("Admin");
}
<div class="page-toolbar">
    <div><a href="/Grades/Gradebook" class="back-link">← Gradebook</a><h2>Grade details</h2></div>
</div>

<div id="gradeDetails" class="panel">Loading...</div>

@section Scripts {
<script>
const gradeId = "@id";
const isAdmin = @isAdmin.ToString().ToLowerInvariant();

async function loadGrade() {
    const result = await callApi(`/api/grades/${gradeId}`, "GET");
    const container = document.getElementById("gradeDetails");

    if (!result.ok) {
        container.innerHTML = `<div class="alert alert-danger">${escapeHtml(result.message)}</div>`;
        return;
    }

    const g = result.data;
    let actions = "";

    if (g.status === "Draft") {
        actions += `<button class="btn btn-outline-primary" onclick="transition('submit')">Submit</button>`;
    }
    if (g.status === "Submitted") {
        actions += `<button class="btn btn-outline-secondary" onclick="transition('draft')">Return to draft</button>`;
        actions += `<button class="btn btn-primary" onclick="transition('publish')">Publish</button>`;
    }
    if (g.status === "Published") {
        actions += `<button class="btn btn-outline-secondary" onclick="transition('unpublish')">Unpublish</button>`;
        actions += `<button class="btn btn-primary" onclick="transition('lock')">Lock</button>`;
    }
    if (g.status === "Locked" && isAdmin) {
        actions += `<button class="btn btn-danger" onclick="transition('unlock')">Unlock</button>`;
    }

    container.innerHTML = `
        <div class="detail-grid">
            <div><small>Student</small><strong>${escapeHtml(g.studentName || "")}</strong></div>
            <div><small>Assessment</small><strong>${escapeHtml(g.assessmentName || "")}</strong></div>
            <div><small>Score</small><strong>${g.score ?? "—"}</strong></div>
            <div><small>Status</small><strong><span class="status-badge">${escapeHtml(g.status)}</span></strong></div>
        </div>
        <hr />
        <div class="action-row">${actions || `<span class="text-muted">No workflow actions are available for this grade.</span>`}</div>`;
}

async function transition(action) {
    const result = await callApi(`/api/grades/${gradeId}/${action}`, "POST");
    showToast(result.message || (result.ok ? "Grade updated." : "Operation failed."), result.ok ? "success" : "danger");
    if (result.ok) loadGrade();
}
loadGrade();
</script>
}
