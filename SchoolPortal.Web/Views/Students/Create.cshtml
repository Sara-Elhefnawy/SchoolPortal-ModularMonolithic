@{
    ViewData["Title"] = "Add student";
}
<div class="form-page">
    <div class="page-toolbar">
        <div><h2>New student</h2><p class="text-muted">Create the student's profile and address.</p></div>
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
    </div>

    <div class="panel">
        <form id="studentForm">
            <div class="row g-3">
                <div class="col-md-6"><label class="form-label">Name</label><input name="name" class="form-control" required /></div>
                <div class="col-md-6"><label class="form-label">Email</label><input name="email" type="email" class="form-control" required /></div>
                <div class="col-md-6"><label class="form-label">Phone</label><input name="phoneNumber" class="form-control" /></div>
                <div class="col-md-6"><label class="form-label">Date of birth</label><input name="dateOfBirth" type="date" class="form-control" required /></div>
                <div class="col-md-6">
                    <label class="form-label">Gender</label>
                    <select name="gender" class="form-select">
                        <option value="Male">Male</option><option value="Female">Female</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Admission date</label>
                    <input id="admissionDate" name="admissionDate" type="date" class="form-control" required />
                </div>
            </div>

            <h5 class="mt-4">Address</h5>
            <div class="row g-3">
                <div class="col-md-6"><label class="form-label">Country</label><input name="country" class="form-control" required /></div>
                <div class="col-md-6"><label class="form-label">State / Governorate</label><input name="state" class="form-control" required /></div>
                <div class="col-md-6"><label class="form-label">City</label><input name="city" class="form-control" required /></div>
                <div class="col-md-3"><label class="form-label">Zip code</label><input name="zipCode" class="form-control" required /></div>
                <div class="col-md-3"><label class="form-label">Building number</label><input name="buildingNumber" type="number" min="1" class="form-control" required /></div>
            </div>

            <button class="btn btn-primary mt-4">Create student</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
// Prefill admission date with today. It's the common case, and the field stays editable.
// toISOString() is UTC and can be off by a day near midnight, so build the date from local parts.
const today = new Date();
document.getElementById("admissionDate").value =
    `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, "0")}-${String(today.getDate()).padStart(2, "0")}`;

document.getElementById("studentForm").addEventListener("submit", async e => {
    e.preventDefault();

    const data = formToObject(e.target);

    // The command's BuildingNumber is an int. Form values are strings, so convert
    // explicitly instead of depending on the server's number-from-string leniency.
    data.buildingNumber = Number(data.buildingNumber);

    const result = await callApi("/api/students", "POST", data);
    if (result.ok) window.location.href = "/Students";
    else showToast(result.message || "Could not create student.", "danger");
});
</script>
}