@{
    Layout = "_Layout";
    ViewData["Title"] = "Create account";
}
<div class="auth-card">
    <div class="brand auth-brand"><span class="brand-mark">SP</span> SchoolPortal</div>
    <h1>Create account</h1>
    <p class="text-muted">Create a SchoolPortal account.</p>

    <form id="signupForm">
        <label class="form-label">Full name</label>
        <input class="form-control mb-3" name="name" required />

        <label class="form-label">Email</label>
        <input class="form-control mb-3" name="email" type="email" required />

        <label class="form-label">Password</label>
        <input class="form-control mb-3" name="password" type="password" required />

        <button class="btn btn-primary w-100">Create account</button>
    </form>

    <div id="loginError" class="alert alert-danger mt-3 d-none"></div>
    <div class="auth-links">
        <a asp-controller="Account" asp-action="Login">Already have an account?</a>
    </div>
</div>

@section Scripts {
    <script>
document.getElementById("signupForm").addEventListener("submit", async e => {
    e.preventDefault();
    const result = await callApi("/api/account/signup", "POST", formToObject(e.target));
    if (result.ok) {
        window.location.href = "/Account/Login";
    } else {
        showToast(result.message || "Could not create account.", "danger");
    }
        });
</script>
}