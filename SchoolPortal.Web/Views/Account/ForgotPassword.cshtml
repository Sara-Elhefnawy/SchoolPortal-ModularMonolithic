@{
    Layout = "_Layout";
    ViewData["Title"] = "Forgot password";
}
<div class="auth-card">
    <div class="brand auth-brand"><span class="brand-mark">SP</span> SchoolPortal</div>
    <h1>Forgot password?</h1>
    <p class="text-muted">Enter your email and we will process the password reset request.</p>
    <form id="forgotForm">
        <label class="form-label">Email</label>
        <input class="form-control mb-3" name="email" type="email" required />
        <button class="btn btn-primary w-100">Continue</button>
    </form>
</div>

@section Scripts {
    <script>
document.getElementById("forgotForm").addEventListener("submit", async e => {
    e.preventDefault();
    const result = await callApi("/api/account/forgot-password", "POST", formToObject(e.target));
    showToast(result.message || "If the account exists, reset instructions will be processed.", result.ok ? "success" : "danger");
});
</script>
}