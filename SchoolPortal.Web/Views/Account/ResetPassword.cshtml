@model SchoolPortal.SharedKernel.Emails.ResetPasswordEmailModel

<div class="auth-card">
    <div class="brand auth-brand">
        <span class="brand-mark">SP</span> SchoolPortal
    </div>

    <h1>Reset your password</h1>

    <p class="text-muted">
        We received a request to reset your SchoolPortal password.
    </p>

    <p class="text-muted">
        Click the button below to choose a new password.
    </p>

    <a href="@Model.ResetLink" class="btn btn-primary w-100">
        Reset Password
    </a>

    <p class="text-muted mt-3">
        If you did not request a password reset, you can safely ignore this email.
    </p>
</div>