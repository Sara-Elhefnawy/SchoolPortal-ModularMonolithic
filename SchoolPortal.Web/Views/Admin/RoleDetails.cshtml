@{
    ViewData["Title"] = "Role permissions";
    var id = ViewContext.RouteData.Values["id"];
}
<div class="page-toolbar"><div><a href="/Admin/Roles" class="back-link">← Roles</a><h2 id="roleName">Role</h2></div>
    <button id="savePermissions" class="btn btn-primary">Save permissions</button></div>
<div class="panel"><p class="text-muted">Select what this role is allowed to do.</p><div id="permissionMatrix">Loading...</div></div>
@section Scripts {
    <script>
const roleId="@id";
let allPermissions=[];
async function load() {
 const p=await callApi("/api/admin/permissions","GET");
 const r=await callApi(`/api/admin/roles/${roleId}/permissions`,"GET");
 if(!p.ok||!r.ok){document.getElementById("permissionMatrix").textContent="Could not load permissions.";return;}
 allPermissions=p.data||[];
 const selected=new Set(r.data||[]);
 document.getElementById("permissionMatrix").innerHTML=allPermissions.map(x=>`
 <label class="permission-row"><span><strong>${escapeHtml(x.name||x)}</strong><small>${escapeHtml(x.description||"")}</small></span>
 <input type="checkbox" value="${escapeHtml(x.name||x)}" ${selected.has(x.name||x)?"checked":""}></label>`).join("");
}
document.getElementById("savePermissions").addEventListener("click",async()=>{
 const permissions=[...document.querySelectorAll("#permissionMatrix input:checked")].map(x=>x.value);
 const r=await callApi(`/api/admin/roles/${roleId}/permissions`,"PUT",{permissions});
 showToast(r.message||(r.ok?"Permissions saved.":"Could not save permissions."),r.ok?"success":"danger");
});
load();
</script>
}