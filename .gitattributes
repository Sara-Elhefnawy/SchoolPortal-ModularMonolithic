# Normalize line endings
* text=auto

# Source files
*.cs text diff=csharp
*.csproj text
*.sln text
*.json text
*.xml text
*.yml text
*.yaml text
*.md text
*.txt text

# Web files
*.html text
*.css text
*.js text

# Never modify binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.dll binary
*.exe binary